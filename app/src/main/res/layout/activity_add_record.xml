<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F7F1"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/home_add_record"
            android:textColor="#426B57"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/add_record_subtitle"
            android:textColor="#555555"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="@string/label_steps"
            android:textColor="#263F32"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/etSteps"
            android:textColor="#263F32"
            android:textColorHint="#555555"
            android:layout_width="280dp"
            android:layout_gravity="center_horizontal"
            android:layout_height="wrap_content"
            android:hint="@string/hint_steps"
            android:inputType="number"
            android:importantForAutofill="no"
            android:padding="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/label_calories"
            android:textColor="#263F32"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/etCalories"
            android:textColor="#263F32"
            android:textColorHint="#555555"
            android:layout_width="280dp"
            android:layout_gravity="center_horizontal"
            android:layout_height="wrap_content"
            android:hint="@string/hint_calories"
            android:inputType="number"
            android:importantForAutofill="no"
            android:padding="14dp" />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/label_water"
            android:textColor="#263F32"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/etWater"
            android:textColor="#263F32"
            android:textColorHint="#555555"
            android:layout_width="280dp"
            android:layout_gravity="center_horizontal"
            android:layout_height="wrap_content"
            android:hint="@string/hint_water"
            android:inputType="number"
            android:importantForAutofill="no"
            android:padding="14dp" />

        <Button
            android:id="@+id/btnSaveRecord"
            android:layout_width="280dp"
            android:layout_gravity="center_horizontal"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="@string/save_record"
            android:backgroundTint="#426B57"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>
