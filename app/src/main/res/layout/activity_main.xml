<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F7F1"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/home_app_title"
            android:textColor="#426B57"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/home_subtitle"
            android:textColor="#555555"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="@string/home_overview"
            android:textColor="#263F32"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDashboardSteps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="#DDECE1"
            android:padding="24dp"
            android:text="@string/dashboard_steps"
            android:textColor="#263F32"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/tvDashboardCalories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#F2E5D5"
            android:padding="24dp"
            android:text="@string/dashboard_calories"
            android:textColor="#5C4536"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/tvDashboardWater"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#DCECF2"
            android:padding="24dp"
            android:text="@string/dashboard_water"
            android:textColor="#345363"
            android:textSize="20sp" />

        <!-- Daily Water Goal -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#DCECF2"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/water_goal_title"
                android:textColor="#345363"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWaterGoalProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/water_goal_progress"
                android:textColor="#345363"
                android:textSize="16sp" />

            <ProgressBar
                android:id="@+id/progressWaterGoal"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:layout_marginTop="12dp"
                android:max="100"
                android:progress="0"
                android:progressTint="#426B57"
                android:progressBackgroundTint="#B8D3DE" />

            <TextView
                android:id="@+id/tvWaterGoalPercentage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/water_goal_percentage"
                android:textColor="#345363"
                android:textSize="14sp" />

        </LinearLayout>

        <Button
            android:id="@+id/btnAddRecord"
            android:layout_width="280dp"
            android:layout_gravity="center_horizontal"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/home_add_record"
            android:backgroundTint="#426B57"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnViewRecords"
            android:layout_width="280dp"
            android:layout_gravity="center_horizontal"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/home_view_records"
            android:backgroundTint="#426B57"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>
