<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:orientation="vertical"
    android:background="#DDECE1"
    android:padding="18dp">

    <TextView
        android:id="@+id/tvRecordDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/record_date_label"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#263F32" />

    <TextView
        android:id="@+id/tvRecordSteps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/record_steps_label"
        android:textSize="16sp"
        android:textColor="#263F32" />

    <TextView
        android:id="@+id/tvRecordCalories"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/record_calories_label"
        android:textSize="16sp"
        android:textColor="#263F32" />

    <TextView
        android:id="@+id/tvRecordWater"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/record_water_label"
        android:textSize="16sp"
        android:textColor="#263F32" />

    <Button
        android:id="@+id/btnEditRecord"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/record_edit"
        android:layout_marginTop="10dp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#426B57" />

    <Button
        android:id="@+id/btnDeleteRecord"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/record_delete"
        android:textColor="#FFFFFF"
        android:backgroundTint="#A63D3D" />

</LinearLayout>
