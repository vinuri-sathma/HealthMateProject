<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#263F32"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvEditStepsLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/edit_steps_hint"
        android:textSize="14sp"
        android:textColor="#FFFFFF"
        android:labelFor="@id/etEditSteps"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etEditSteps"
        android:layout_width="280dp"
        android:layout_height="48dp"
        android:inputType="number"
        android:textColor="#FFFFFF"
        android:backgroundTint="#FFFFFF"
        android:importantForAutofill="no" />

    <TextView
        android:id="@+id/tvEditCaloriesLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/edit_calories_hint"
        android:textSize="14sp"
        android:textColor="#FFFFFF"
        android:labelFor="@id/etEditCalories"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etEditCalories"
        android:layout_width="280dp"
        android:layout_height="48dp"
        android:inputType="number"
        android:textColor="#FFFFFF"
        android:backgroundTint="#FFFFFF"
        android:importantForAutofill="no" />

    <TextView
        android:id="@+id/tvEditWaterLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/edit_water_hint"
        android:textSize="14sp"
        android:textColor="#FFFFFF"
        android:labelFor="@id/etEditWater"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etEditWater"
        android:layout_width="280dp"
        android:layout_height="48dp"
        android:inputType="number"
        android:textColor="#FFFFFF"
        android:backgroundTint="#FFFFFF"
        android:importantForAutofill="no" />

</LinearLayout>
