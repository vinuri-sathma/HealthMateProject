<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F7F1"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="My Health Records"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#426B57" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="View your daily wellness history"
        android:textSize="14sp"
        android:textColor="#777777" />

    <EditText
        android:id="@+id/etSearchDate"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:hint="Search by date (YYYY-MM-DD)"
        android:inputType="date"
        android:focusable="false"
        android:clickable="true"
        android:backgroundTint="#426B57"
        android:padding="12dp" />

    <Button
        android:id="@+id/btnClearSearch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Show All Records"
        android:textColor="#FFFFFF"
        android:backgroundTint="#426B57" />

    <TextView
        android:id="@+id/tvEmptyRecords"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="No health records available"
        android:textSize="16sp"
        android:gravity="center"
        android:textColor="#777777"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvHealthRecords"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="20dp" />

</LinearLayout>
