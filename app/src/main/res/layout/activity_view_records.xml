<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F7F1"
    android:padding="20dp"
    android:fitsSystemWindows="true">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/records_title"
        android:layout_marginStart="15dp"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#426B57" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/records_subtitle"
        android:layout_marginStart="15dp"
        android:textSize="14sp"
        android:textColor="#555555" />

    <EditText
        android:id="@+id/etSearchDate"
        android:textColor="#263F32"
        android:textColorHint="#555555"
        android:layout_width="280dp"
        android:layout_gravity="center_horizontal"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:hint="@string/search_date_hint"
        android:inputType="date"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:clickable="true"
        android:importantForAutofill="no"
        android:backgroundTint="#426B57"
        android:padding="12dp" />

    <Button
        android:id="@+id/btnClearSearch"
        android:layout_marginStart="15dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/show_all_records"
        android:textColor="#FFFFFF"
        android:backgroundTint="#426B57" />

    <TextView
        android:id="@+id/tvEmptyRecords"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="@string/no_records"
        android:textSize="16sp"
        android:gravity="center"
        android:textColor="#555555"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvHealthRecords"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="20dp" />

</LinearLayout>
